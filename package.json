{
  "name": "@mano8/astro-prompt-m8",
  "version": "2.1.0",
  "description": "Astro integration and headless client for prompt-engine-m8.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mano8/astro-prompt-m8.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "prompt-engine",
    "prompt-engine-m8",
    "m8"
  ],
  "files": [
    "dist",
    "src/routes",
    "src/scaffold/styles",
    "registry.json",
    "registry/r",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/src/integration.js",
    "./api": "./dist/src/runtime/api/index.js",
    "./client": "./dist/src/runtime/client.js",
    "./schemas": "./dist/src/runtime/schemas.js",
    "./auth-adapter": "./dist/src/runtime/authAdapter.js",
    "./hooks": "./dist/src/runtime/hooks/index.js",
    "./react": "./dist/src/runtime/react/index.js",
    "./default-ui": "./dist/src/runtime/react/default-ui/index.js",
    "./list-params": "./dist/src/runtime/listParams.js",
    "./routes": "./dist/src/runtime/routes.js",
    "./routes/blocks.astro": "./src/routes/blocks.astro",
    "./routes/templates.astro": "./src/routes/templates.astro",
    "./routes/composer.astro": "./src/routes/composer.astro",
    "./routes/admin/prompts.astro": "./src/routes/admin/prompts.astro",
    "./middleware": "./dist/src/middleware.js",
    "./internal-server": "./dist/src/runtime/api/internal.server.js",
    "./compatibility": "./dist/src/runtime/compatibility.js"
  },
  "types": "./dist/src/integration.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:registry",
    "build:registry": "node scripts/build-registry.mjs",
    "lint": "eslint .",
    "preview:dev": "vite --config fixtures/preview/vite.config.ts",
    "preview:build": "tsc -p fixtures/preview/tsconfig.json --noEmit && vite build --config fixtures/preview/vite.config.ts",
    "verify:contract-drift": "node scripts/verify-contract-drift.mjs",
    "verify:fleet-gates": "node scripts/verify-fleet-gates.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "verify:registry-drift": "node scripts/verify-registry-drift.mjs",
    "verify:starter-routes": "node scripts/verify-starter-routes.mjs",
    "verify:tarball-install": "node scripts/verify-tarball-install.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mano8/astro-ui-m8": "^1.5.0"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@mano8/astro-auth-m8": "^2.4.0",
    "@tanstack/react-query": "^5.102.8",
    "astro": "^7.0.9",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.10",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@mano8/astro-auth-m8": "^2.4.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.2.9",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "promptEngineM8": {
    "contract": "prompt-engine-m8@2.1.0",
    "testedServiceVersion": "2.1.0",
    "serviceVersionRange": ">=2.1.0 <3.0.0",
    "openapi": "contracts/prompt-engine-m8.openapi.json"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
